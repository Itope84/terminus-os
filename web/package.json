{
  "name": "terminus-web",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "expo start --web --port 9010",
    "build": "rm -rf dist && EXPO_NO_TELEMETRY=1 expo export --platform web --clear && node scripts/build-sw.mjs dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@expo/vector-icons": "15.1.1",
    "dompurify": "^3.2.6",
    "expo": "57.0.26",
    "expo-constants": "57.0.20",
    "expo-font": "57.0.4",
    "expo-linking": "57.0.11",
    "expo-router": "57.0.24",
    "expo-status-bar": "57.0.1",
    "expo-system-ui": "57.0.4",
    "leaflet": "1.9.4",
    "marked": "^16.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-web": "0.21.3",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@types/dompurify": "^3.2.0",
    "@types/leaflet": "^1.9.23",
    "@types/react": "19.2.18",
    "typescript": "~5.9.3",
    "vitest": "^5.1.0"
  }
}
