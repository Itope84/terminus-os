<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="76dp"
    android:gravity="center_vertical"
    android:padding="8dp"
    android:background="?android:attr/selectableItemBackground">

    <FrameLayout
        android:id="@+id/attachmentTile"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/thumb_frame"
        android:clipToOutline="true">

        <ImageView
            android:id="@+id/attachmentThumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:visibility="gone"
            android:contentDescription="attachment image preview" />

        <TextView
            android:id="@+id/attachmentType"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="FILE"
            android:textSize="@dimen/ts_caption"
            android:textStyle="bold"
            android:textColor="@color/t_muted" />
    </FrameLayout>

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp">

        <TextView
            android:id="@+id/attachmentName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="@dimen/ts_small"
            android:textStyle="bold"
            android:textColor="@color/t_ink"
            android:maxLines="2"
            android:ellipsize="middle" />

        <TextView
            android:id="@+id/attachmentMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textSize="@dimen/ts_caption"
            android:textColor="@color/t_muted"
            android:singleLine="true"
            android:ellipsize="end" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/attachmentShareButton"
        android:focusable="false"
        android:layout_width="44dp"
        android:layout_height="48dp"
        android:padding="12dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_share"
        android:tint="@color/t_muted"
        android:contentDescription="share attachment" />
</LinearLayout>
