<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingLeft="16dp" android:paddingRight="16dp"
    android:paddingTop="10dp" android:paddingBottom="2dp"
    android:gravity="center_vertical">
    <TextView android:id="@+id/groupLabel"
        android:layout_width="0dp" android:layout_weight="1"
        android:layout_height="wrap_content"
        android:textSize="@dimen/ts_caption"
        android:fontFamily="monospace"
        android:textColor="@color/t_ink" />
    <TextView android:id="@+id/groupCount"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textSize="@dimen/ts_caption"
        android:fontFamily="monospace"
        android:textColor="@color/t_muted" />
    <TextView android:id="@+id/groupChev"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:textSize="@dimen/ts_small"
        android:textColor="@color/t_muted" />
</LinearLayout>
