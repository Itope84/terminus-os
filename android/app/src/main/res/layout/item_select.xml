<?xml version="1.0" encoding="utf-8"?>
<!-- Dedicated select-sheet row: optional logo + title + sub + check. Replaces the
  - borrowed model-picker row so generic menus stop wearing model clothes. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="56dp"
    android:gravity="center_vertical"
    android:paddingLeft="4dp"
    android:paddingRight="4dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:background="?android:attr/selectableItemBackground">

    <!-- Optional logo (backend picker); gone for plain menus. -->
    <ImageView
        android:id="@+id/selectIcon"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="14dp"
        android:scaleType="fitCenter"
        android:visibility="gone"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/selectName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="@dimen/ts_body"
            android:textStyle="bold"
            android:textColor="@color/t_ink"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/selectSub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="@dimen/ts_caption"
            android:textColor="@color/t_muted"
            android:singleLine="true"
            android:ellipsize="end" />

    </LinearLayout>

    <TextView
        android:id="@+id/selectCheck"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:gravity="center"
        android:text="✓"
        android:textSize="@dimen/ts_lead"
        android:textStyle="bold"
        android:textColor="@color/t_ok"
        android:visibility="gone"
        android:contentDescription="selected" />

</LinearLayout>
