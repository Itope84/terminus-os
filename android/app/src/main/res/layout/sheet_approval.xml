<?xml version="1.0" encoding="utf-8"?>
<!-- Approval sheet: who is asking, what, a countdown, Allow / Deny. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="20dp"
    android:paddingBottom="28dp">

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/apprSource"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/needs_pill"
            android:paddingStart="10dp" android:paddingEnd="10dp"
            android:paddingTop="3dp" android:paddingBottom="3dp"
            android:text="Codex"
            android:textSize="@dimen/ts_caption"
            android:textStyle="bold"
            android:textColor="@color/t_warn" />

        <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

        <TextView
            android:id="@+id/apprTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textSize="@dimen/ts_caption"
            android:textColor="@color/t_muted" />
    </LinearLayout>

    <TextView
        android:id="@+id/apprTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Needs approval"
        android:textSize="@dimen/ts_lead"
        android:textStyle="bold"
        android:textColor="@color/t_ink" />

    <ScrollView
        android:id="@+id/apprDetailWrap"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/field_bg">

        <TextView
            android:id="@+id/apprDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:fontFamily="monospace"
            android:textIsSelectable="true"
            android:textSize="@dimen/ts_caption"
            android:textColor="@color/t_ink" />
    </ScrollView>

    <TextView
        android:id="@+id/apprHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Allow runs it once. No answer means no."
        android:textSize="@dimen/ts_caption"
        android:textColor="@color/t_muted" />

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/apprDeny"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="52dp"
            android:text="Deny"
            app:cornerRadius="12dp"
            android:textColor="@color/t_ink" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/apprAllow"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="52dp"
            android:layout_marginStart="12dp"
            android:text="Allow once"
            app:cornerRadius="12dp"
            android:backgroundTint="@color/t_ink"
            android:textColor="@color/t_window" />
    </LinearLayout>

    <TextView
        android:id="@+id/apprOpen"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center"
        android:text="Open chat"
        android:visibility="gone"
        android:textSize="@dimen/ts_small"
        android:textColor="@color/t_muted"
        android:background="?android:attr/selectableItemBackground" />
</LinearLayout>
