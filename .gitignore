# Per-chat working notes: the folder exists in the repo, its contents never do.
/agentbook/*
!/agentbook/.gitkeep

# Personal data and machine state: notebook weeklies, runtime state, models, keys, local databases.
# notebook/user.md ships as an empty placeholder; `make install` marks it skip-worktree so
# the real details you write there stay local.
/notebook/*
!/notebook/.gitkeep
!/notebook/user.md
